{
  "name": "@beiifeng/decentralized-host-provider",
  "version": "1.0.0-alpha.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*.js": "./dist/*.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write ./lib/**/*.{ts,tsx,js,jsx,json}",
    "lint": "eslint ./lib/**/*.{ts,tsx,js,jsx}"
  },
  "keywords": [
    "decentralized-host-provider"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "penpal": "^8.0.1",
    "penpal-v4": "npm:penpal@^4.1.1",
    "penpal-v6": "npm:penpal@^6.2.2",
    "penpal-v7": "npm:penpal@^7.0.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 | ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
