{
  "name": "@beiifeng/trustvc-frame-provider",
  "version": "1.0.0-alpha.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*.js": "./dist/*.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write ./lib/**/*.{ts,tsx,js,jsx,json}",
