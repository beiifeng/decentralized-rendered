  },
  "keywords": [
    "trustvc",
    "opencerts",
    "frame-provider"
  ],
  "author": "YiFei Wang <beiifeng@hotmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 | ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
