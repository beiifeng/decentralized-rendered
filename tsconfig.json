{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2023",
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",

    "sourceMap": false,
    "declaration": true,
    "incremental": false,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": true,

    "paths": {
      "@beiifeng/trustvc-host-provider": ["./packages/host-provider/lib"],
      "@beiifeng/trustvc-host-provider/*": ["./packages/host-provider/lib/*"],
      "@beiifeng/trustvc-frame-provider": ["./packages/frame-provider/lib"],
      "@beiifeng/trustvc-frame-provider/*": ["./packages/frame-provider/lib/*"],
      "@beiifeng/trustvc-penpal-v5-adapter": ["./packages/penpal-v5-adapter/lib"],
      "@beiifeng/trustvc-penpal-v5-adapter/*": ["./packages/penpal-v5-adapter/lib/*"]
    }
  },
  "exclude": ["**/.*/", "**/build", "**/node_modules", "**/dist"]
}
